#!/usr/bin/env bash
# Janim's command line: one ordinary process per call. It runs on the
# checkout's virtual environment when there is one, otherwise on python3.
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
python="$here/.venv/bin/python"
[ -x "$python" ] || python="$(command -v python3)"
exec "$python" -m janim.cli "$@"
